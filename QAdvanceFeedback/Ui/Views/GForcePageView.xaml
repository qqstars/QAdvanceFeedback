<UserControl x:Class="QAdvanceFeedbackViews.GForcePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:QAdvanceFeedbackControls"
             xmlns:v="clr-namespace:QAdvanceFeedbackViews"
             xmlns:gf="clr-namespace:QAdvanceFeedback.Core.GForce"
             x:Name="GForcePageRoot"
             v:ViewModelLifetime.Activate="True">
  <!-- The plugin page's G-Force tab (docs\full-mvvm-plan.md 3.3), bound to a GForcePageViewModel. The
       page hosts it inside the tab's ScrollViewer; the page's implicit styles (TextBlock/ComboBox/GroupBox/
       CheckBox/Button margins and widths) reach in here on purpose. Layout, x:Names, SharedSizeGroups and
       widths are the old SettingsControl.xaml G-Force region's, with every imperative write replaced by a
       binding. Grid.IsSharedSizeScope is set once, at tab level, on this view by SettingsPageView. -->
  <UserControl.Resources>
    <v:VisibleWhenConverter x:Key="VisibleWhen"/>
  </UserControl.Resources>

  <StackPanel>
    <GroupBox x:Name="GForceMaximaGroup" Header="{v:Loc Group.GForceMaxima}">
      <StackPanel>
        <TextBlock x:Name="GForceMaximaNote" Text="{v:Loc GForce.Maxima.Note}" TextWrapping="Wrap" FontStyle="Italic"/>

        <!-- ONE GRID, so the two rows line up column-for-column (owner: "align the maximum
             acc G and break G vertically"). Two StackPanels could not - each sized its own
             label independently, so the toggles and value boxes never lined up. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Under Auto the max-G box stays editable (it is what Auto falls back to); the readout
               beside it is what tells Auto's state (GForcePageAxisViewModel). -->
          <TextBlock          Grid.Row="0" Grid.Column="0" x:Name="GForceLblAccelMax" Text="{v:Loc GForce.AccelMax.Label}"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock x:Name="GForceAccelAutoLabel" Text="{v:Loc GForce.Mode.Auto.Short}"/>
            <mah:ToggleSwitch x:Name="GForceAccelAutoToggle" Margin="4" IsChecked="{Binding AccelMax.Auto}"
                              OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"/>
          </StackPanel>
          <local:NumericEditor  Grid.Row="0" Grid.Column="2" x:Name="GForceFixedAccelMax" Value="{Binding AccelMax.Max}" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
          <TextBlock          Grid.Row="0" Grid.Column="3" x:Name="GForceAccelLearnedText" Text="{Binding AccelMax.Readout}" TextWrapping="Wrap"/>

          <TextBlock          Grid.Row="1" Grid.Column="0" x:Name="GForceLblDecelMax" Text="{v:Loc GForce.DecelMax.Label}"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock x:Name="GForceDecelAutoLabel" Text="{v:Loc GForce.Mode.Auto.Short}"/>
            <mah:ToggleSwitch x:Name="GForceDecelAutoToggle" Margin="4" IsChecked="{Binding DecelMax.Auto}"
                              OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"/>
          </StackPanel>
          <local:NumericEditor  Grid.Row="1" Grid.Column="2" x:Name="GForceFixedDecelMax" Value="{Binding DecelMax.Max}" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
          <TextBlock          Grid.Row="1" Grid.Column="3" x:Name="GForceDecelLearnedText" Text="{Binding DecelMax.Readout}" TextWrapping="Wrap"/>

          <TextBlock          Grid.Row="2" Grid.Column="0" x:Name="GForceLblLatMax" Text="{v:Loc GForce.LatMax.Label}"/>
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock x:Name="GForceLatAutoLabel" Text="{v:Loc GForce.Mode.Auto.Short}"/>
            <mah:ToggleSwitch x:Name="GForceLatAutoToggle" Margin="4" IsChecked="{Binding LatMax.Auto}"
                              OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"/>
          </StackPanel>
          <local:NumericEditor  Grid.Row="2" Grid.Column="2" x:Name="GForceFixedLatMax" Value="{Binding LatMax.Max}" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
          <TextBlock          Grid.Row="2" Grid.Column="3" x:Name="GForceLatLearnedText" Text="{Binding LatMax.Readout}" TextWrapping="Wrap"/>
        </Grid>

        <!-- OUTPUT SCALES (v1.0.8) - a per-axis attenuator, so the whole G-force feel can be
             turned down without touching the wheel lock/slip shake. -->
        <TextBlock x:Name="GForceScaleNote" Text="{v:Loc GForce.ScaleNote}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,8,0,2"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblAccelScale" Text="{v:Loc GForce.AccelScale.Label}"/>
          <local:NumericEditor Grid.Row="0" Grid.Column="1" x:Name="GForceAccelScale" Value="{Binding AccelScale}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblBrakeScale" Text="{v:Loc GForce.BrakeScale.Label}"/>
          <local:NumericEditor Grid.Row="1" Grid.Column="1" x:Name="GForceBrakeScale" Value="{Binding BrakeScale}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblLateralScale" Text="{v:Loc GForce.LateralScale.Label}"/>
          <local:NumericEditor Grid.Row="2" Grid.Column="1" x:Name="GForceLateralScale" Value="{Binding LateralScale}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>
        </Grid>

        <TextBlock x:Name="GForceRecommendedHzText" Text="{Binding RecommendedHzText}" TextWrapping="Wrap"/>
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="GForceLatSplitGroup" Header="{v:Loc Group.GForceLatSplit}">
      <StackPanel>
        <TextBlock x:Name="GForceLatSplitNote" Text="{v:Loc GForce.LatSplit.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblBrakeBottomFrontLatSplit" Text="{v:Loc GForce.LatSplit.BrakeBottomFront}"/>
          <local:NumericEditor Grid.Row="0" Grid.Column="1" x:Name="GForceBrakeBottomFrontLatSplit" Value="{Binding BrakeBottomFrontLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblBrakeBottomRearLatSplit" Text="{v:Loc GForce.LatSplit.BrakeBottomRear}"/>
          <local:NumericEditor Grid.Row="1" Grid.Column="1" x:Name="GForceBrakeBottomRearLatSplit" Value="{Binding BrakeBottomRearLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblBrakeBackLowLatSplit" Text="{v:Loc GForce.LatSplit.BrakeBackLow}"/>
          <local:NumericEditor Grid.Row="2" Grid.Column="1" x:Name="GForceBrakeBackLowLatSplit" Value="{Binding BrakeBackLowLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblAccelBottomRearLatSplit" Text="{v:Loc GForce.LatSplit.AccelBottomRear}"/>
          <local:NumericEditor Grid.Row="3" Grid.Column="1" x:Name="GForceAccelBottomRearLatSplit" Value="{Binding AccelBottomRearLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="4" Grid.Column="0" x:Name="GForceLblAccelBackLowLatSplit" Text="{v:Loc GForce.LatSplit.AccelBackLow}"/>
          <local:NumericEditor Grid.Row="4" Grid.Column="1" x:Name="GForceAccelBackLowLatSplit" Value="{Binding AccelBackLowLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>

          <TextBlock Grid.Row="5" Grid.Column="0" x:Name="GForceLblAccelBackTopLatSplit" Text="{v:Loc GForce.LatSplit.AccelBackTop}"/>
          <local:NumericEditor Grid.Row="5" Grid.Column="1" x:Name="GForceAccelBackTopLatSplit" Value="{Binding AccelBackTopLatSplit}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>
        </Grid>
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="GForceSustainGroup" Header="{v:Loc Group.GForceSustain}">
      <StackPanel>
        <TextBlock x:Name="GForceSustainNote" Text="{v:Loc GForce.Sustain.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblBrakeBottomRear" Text="{v:Loc GForce.Sustain.BrakeBottomRear}"/>
          <local:NumericEditor Grid.Row="0" Grid.Column="1" x:Name="GForceBrakeBottomRearSustain" Value="{Binding BrakeBottomRearSustain}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblBrakeBackLow" Text="{v:Loc GForce.Sustain.BrakeBackLow}"/>
          <local:NumericEditor Grid.Row="1" Grid.Column="1" x:Name="GForceBrakeBackLowSustain" Value="{Binding BrakeBackLowSustain}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblAccelBottomRear" Text="{v:Loc GForce.Sustain.AccelBottomRear}"/>
          <local:NumericEditor Grid.Row="2" Grid.Column="1" x:Name="GForceAccelBottomRearSustain" Value="{Binding AccelBottomRearSustain}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblAccelBackLow" Text="{v:Loc GForce.Sustain.AccelBackLow}"/>
          <local:NumericEditor Grid.Row="3" Grid.Column="1" x:Name="GForceAccelBackLowSustain" Value="{Binding AccelBackLowSustain}"/>
        </Grid>
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="GForceMotionGroup" Header="{v:Loc Group.GForceMotion}">
      <StackPanel>
        <TextBlock x:Name="GForceMotionNote" Text="{v:Loc GForce.Motion.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto" SharedSizeGroup="GForceSpin"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblSustainTau" Text="{v:Loc GForce.SustainTau.Label}"/>
          <local:NumericEditor Grid.Row="0" Grid.Column="1" x:Name="GForceSustainTau" Value="{Binding SustainTau}" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>
          <TextBlock Grid.Row="0" Grid.Column="2" x:Name="GForceSustainTauHint" Text="{v:Loc GForce.Motion.SustainTau.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblTransientTau" Text="{v:Loc GForce.TransientTau.Label}"/>
          <local:NumericEditor Grid.Row="1" Grid.Column="1" x:Name="GForceTransientTau" Value="{Binding TransientTau}" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>
          <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GForceTransientTauHint" Text="{v:Loc GForce.Motion.TransientTau.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblTransientGain" Text="{v:Loc GForce.TransientGain.Label}"/>
          <local:NumericEditor Grid.Row="2" Grid.Column="1" x:Name="GForceTransientGain" Value="{Binding TransientGain}" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.0"/>
          <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GForceTransientGainHint" Text="{v:Loc GForce.Motion.TransientGain.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblRetriggerStrictness" Text="{v:Loc GForce.Motion.RetriggerStrictness.Label}"/>
          <local:NumericEditor Grid.Row="3" Grid.Column="1" x:Name="GForceRetriggerStrictness" Value="{Binding RetriggerStrictness}" Minimum="0.1" Maximum="5" Interval="0.1" StringFormat="0.0"/>
          <TextBlock Grid.Row="3" Grid.Column="2" x:Name="GForceRetriggerStrictnessHint" Text="{v:Loc GForce.Motion.RetriggerStrictness.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <TextBlock Grid.Row="4" Grid.Column="0" x:Name="GForceLblAutoTransitionScale" Text="{v:Loc GForce.TransitionScale.Auto.Label}"/>
          <local:NumericEditor Grid.Row="4" Grid.Column="1" x:Name="GForceAutoTransitionScale" Value="{Binding AutoTransitionScale}" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.00"/>
          <TextBlock Grid.Row="4" Grid.Column="2" x:Name="GForceAutoTransitionScaleHint" Text="{v:Loc GForce.Motion.AutoTransitionScale.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <TextBlock Grid.Row="5" Grid.Column="0" x:Name="GForceLblFixedTransitionScale" Text="{v:Loc GForce.TransitionScale.Fixed.Label}"/>
          <local:NumericEditor Grid.Row="5" Grid.Column="1" x:Name="GForceFixedTransitionScale" Value="{Binding FixedTransitionScale}" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.00"/>
          <TextBlock Grid.Row="5" Grid.Column="2" x:Name="GForceFixedTransitionScaleHint" Text="{v:Loc GForce.Motion.FixedTransitionScale.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock x:Name="GForceTransitionScaleNote" Text="{v:Loc GForce.TransitionScale.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="GForceLateralGroup" Header="{v:Loc Group.GForceLateral}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="GForceLblLateralDirection" Text="{v:Loc GForce.LateralDirection.Label}"/>
          <ComboBox Grid.Column="1" x:Name="GForceLateralDirectionCombo"
                    SelectedValuePath="Tag" SelectedValue="{Binding LateralDirection, Mode=TwoWay}">
            <ComboBoxItem x:Name="GForceLateralNormal" Tag="{x:Static gf:LateralDirectionMode.Normal}" Content="{v:Loc GForce.LateralDirection.Normal}"/>
            <ComboBoxItem x:Name="GForceLateralReversed" Tag="{x:Static gf:LateralDirectionMode.Reversed}" Content="{v:Loc GForce.LateralDirection.Reversed}"/>
          </ComboBox>
        </Grid>
        <TextBlock x:Name="GForceLateralDirectionNote" Text="{v:Loc GForce.LateralDirection.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
      </StackPanel>
    </GroupBox>

    <!-- Bound to the hosted GForceShakeViewModel (docs\architecture.md "UI: MVVM"): the switches, enabled
         state, mode/feeling rewrite rules and descriptions live there. -->
    <GroupBox x:Name="GForceShakeGroup" Header="{v:Loc Group.GForceShake}" DataContext="{Binding Shake}">
      <StackPanel>
        <!-- A feature SWITCH, not a minor checkbox option (owner's explicit distinction) -
             a prominent MahApps ToggleSwitch, sitting above the settings it governs, with
             both states spelled out via OnLabel/OffLabel (never inferred from a highlight
             alone) and a bold header naming the feature. -->
        <TextBlock x:Name="GForceShakeHeader" Text="{v:Loc GForce.Shake.Enable}" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
        <mah:ToggleSwitch x:Name="GForceShakeEnabled" HorizontalAlignment="Left" Margin="4,2,4,8"
                          OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"
                          IsChecked="{Binding IntegrateWheelLockAndSlip, Mode=TwoWay}"/>
        <TextBlock x:Name="GForceShakeNote" Text="{v:Loc GForce.Shake.Note}" TextWrapping="Wrap" FontStyle="Italic"/>
        <!-- "Integrate Slip Angle" (docs\slip-angle-design.md section 10) - the twin switch: either
             one on runs the shake; each only lets its own source through the gate. -->
        <TextBlock x:Name="GForceShakeAngleHeader" Text="{v:Loc GForce.Shake.Angle.Enable}" FontWeight="Bold" FontSize="14" Margin="4,8,4,0"/>
        <mah:ToggleSwitch x:Name="GForceShakeAngleEnabled" HorizontalAlignment="Left" Margin="4,2,4,8"
                          OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"
                          IsChecked="{Binding IntegrateSlipAngle, Mode=TwoWay}"/>
        <TextBlock x:Name="GForceShakeAngleNote" Text="{v:Loc GForce.Shake.Angle.Note}" TextWrapping="Wrap" FontStyle="Italic"/>

        <!-- MODE SELECTOR (v1.0.8) - sits directly under the toggle it qualifies, with its own
             description below it because each mode does something different enough that one
             shared sentence could not describe them all. A pick restores that mode's own scales
             and trigger (owner decision, GForceShakeViewModel.Mode). -->
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="GForceLblShakeMode" Text="{v:Loc GForce.Shake.Mode.Label}"/>
          <ComboBox Grid.Column="1" x:Name="GForceShakeModeCombo" HorizontalAlignment="Left" MinWidth="260"
                    SelectedValuePath="Tag" SelectedValue="{Binding Mode, Mode=TwoWay}" IsEnabled="{Binding SharedEnabled}">
            <ComboBoxItem x:Name="GForceShakeModeHigherOfBoth" Tag="{x:Static gf:ShakeApplyMode.HigherOfGForceOrLockSlip}" Content="{v:Loc GForce.Shake.Mode.HigherOfBoth}"/>
            <ComboBoxItem x:Name="GForceShakeModePerChannel" Tag="{x:Static gf:ShakeApplyMode.PerChannel}" Content="{v:Loc GForce.Shake.Mode.PerChannel}"/>
            <ComboBoxItem x:Name="GForceShakeModeAllGForce" Tag="{x:Static gf:ShakeApplyMode.AllChannelsGForce}" Content="{v:Loc GForce.Shake.Mode.AllGForce}"/>
            <ComboBoxItem x:Name="GForceShakeModeAllLockSlip" Tag="{x:Static gf:ShakeApplyMode.AllChannelsLockSlip}" Content="{v:Loc GForce.Shake.Mode.AllLockSlip}"/>
          </ComboBox>
        </Grid>
        <TextBlock x:Name="GForceShakeModeDesc" Text="{Binding ModeDescription}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2,0,8"/>

        <!-- SETTINGS ON THE LEFT, LIVE PREVIEW ON THE RIGHT (v1.0.8). The preview is what makes
             the feeling dropdown legible: the three choices differ in how the two pads RELATE,
             which is far easier to see than to read. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" x:Name="GForceShakeSettingsColumn">
            <!-- FEELING - replaces the old "Both-sides blend (%)" number. Placed after the
                 mode's own description and before every spinner, because it changes what the
                 spinners below it mean (and whether Hold is shown at all). -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Name="GForceLblShakeFeeling" Text="{v:Loc GForce.Shake.Feeling.Label}"/>
              <ComboBox Grid.Column="1" x:Name="GForceShakeFeelingCombo" HorizontalAlignment="Left" MinWidth="260"
                        SelectedValuePath="Tag" SelectedValue="{Binding Feeling, Mode=TwoWay}" IsEnabled="{Binding SharedEnabled}">
                <ComboBoxItem x:Name="GForceShakeFeelingOpposite" Tag="{x:Static gf:ShakeFeeling.OppositePhase}" Content="{v:Loc GForce.Shake.Feeling.Opposite}"/>
                <ComboBoxItem x:Name="GForceShakeFeelingSame" Tag="{x:Static gf:ShakeFeeling.SamePhase}" Content="{v:Loc GForce.Shake.Feeling.Same}"/>
                <ComboBoxItem x:Name="GForceShakeFeelingBlending" Tag="{x:Static gf:ShakeFeeling.Blending}" Content="{v:Loc GForce.Shake.Feeling.Blending}"/>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="GForceShakeFeelingDesc" Text="{Binding FeelingDescription}" TextWrapping="Wrap" FontStyle="Italic"
                       Margin="0,2,0,8" MaxWidth="430" HorizontalAlignment="Left"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="GForceSpin"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
              </Grid.RowDefinitions>

              <!-- HOLD first, and hidden entirely for Blending, which pins its own. -->
              <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblShakeSustain" Text="{v:Loc GForce.Shake.Sustain.Label}" Visibility="{Binding SustainVisible, Converter={StaticResource VisibleWhen}}"/>
              <local:NumericEditor Grid.Row="0" Grid.Column="1" x:Name="GForceShakeSustain" Value="{Binding Sustain}" IsEnabled="{Binding SharedEnabled}" Visibility="{Binding SustainVisible, Converter={StaticResource VisibleWhen}}" Minimum="0" Maximum="90" Interval="5" StringFormat="0.#"/>
              <TextBlock Grid.Row="0" Grid.Column="2" x:Name="GForceShakeSustainHint" Text="{v:Loc GForce.Shake.Sustain.Hint}" Visibility="{Binding SustainVisible, Converter={StaticResource VisibleWhen}}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>

              <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblShakeFrequency" Text="{v:Loc GForce.Shake.Frequency.Label}"/>
              <local:NumericEditor Grid.Row="1" Grid.Column="1" x:Name="GForceShakeFrequency" Value="{Binding Frequency}" IsEnabled="{Binding SharedEnabled}" Minimum="1" Maximum="20" Interval="1" StringFormat="0.#"/>
              <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GForceShakeFrequencyHint" Text="{v:Loc GForce.Shake.Frequency.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>

              <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblShakeTrigger" Text="{v:Loc GForce.Shake.Trigger.Label}"/>
              <local:NumericEditor Grid.Row="2" Grid.Column="1" x:Name="GForceShakeTrigger" Value="{Binding Trigger}" IsEnabled="{Binding SharedEnabled}" Minimum="0" Maximum="100" Interval="5" StringFormat="0.#"/>
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GForceShakeTriggerHint" Text="{v:Loc GForce.Shake.Trigger.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>

              <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblShakeLockScale" Text="{v:Loc GForce.Shake.LockScale.Label}"/>
              <local:NumericEditor Grid.Row="3" Grid.Column="1" x:Name="GForceShakeLockScale" Value="{Binding LockScale}" IsEnabled="{Binding LockSlipScalesEnabled}" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>
              <TextBlock Grid.Row="3" Grid.Column="2" x:Name="GForceShakeLockScaleHint" Text="{v:Loc GForce.Shake.Scale.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>

              <TextBlock Grid.Row="4" Grid.Column="0" x:Name="GForceLblShakeSlipScale" Text="{v:Loc GForce.Shake.SlipScale.Label}"/>
              <local:NumericEditor Grid.Row="4" Grid.Column="1" x:Name="GForceShakeSlipScale" Value="{Binding SlipScale}" IsEnabled="{Binding LockSlipScalesEnabled}" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>
              <TextBlock Grid.Row="4" Grid.Column="2" x:Name="GForceShakeSlipScaleHint" Text="{v:Loc GForce.Shake.Scale.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>

              <TextBlock Grid.Row="5" Grid.Column="0" x:Name="GForceLblShakeAngleScale" Text="{v:Loc GForce.Shake.AngleScale.Label}"/>
              <local:NumericEditor Grid.Row="5" Grid.Column="1" x:Name="GForceShakeAngleScale" Value="{Binding AngleScale}" IsEnabled="{Binding AngleScaleEnabled}" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>
              <TextBlock Grid.Row="5" Grid.Column="2" x:Name="GForceShakeAngleScaleHint" Text="{v:Loc GForce.Shake.Scale.Hint}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230"/>
            </Grid>
          </StackPanel>

          <!-- ONE SECOND of simulated output, green Left / red Right. Width matches the
               Lock/Slip curve canvas. The traces are the page view model's (GForcePageShakePreview). -->
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="GForceShakePreviewCaption" Text="{v:Loc GForce.Shake.Preview.Caption}" FontWeight="Bold" Margin="0,0,0,2"/>
            <Border BorderBrush="#FFB0B0B0" BorderThickness="1" HorizontalAlignment="Left">
              <v:GForcePageShakePreviewGraph x:Name="GForceShakePreviewCanvas" Width="420" Height="200"
                                             LeftTrace="{Binding DataContext.PreviewLeft, ElementName=GForcePageRoot}"
                                             RightTrace="{Binding DataContext.PreviewRight, ElementName=GForcePageRoot}"/>
            </Border>
            <TextBlock x:Name="GForceShakePreviewLegend" Text="{v:Loc GForce.Shake.Preview.Legend}" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </GroupBox>

    <!-- ================================ TEST EFFECT (v1.0.8) ============================ -->
    <GroupBox x:Name="GForceTestGroup" Header="{v:Loc Group.GForceTest}">
      <!-- The shared Test Effect view (docs\shakeit-test-effect-mvvm-design.md), bound to the page view
           model's GForceTestViewModel - the same view model the G-Force ShakeIt panels use. It runs on a
           throwaway copy of the page's values: nothing in it is saved or marks the page dirty. -->
      <v:GForceTestView x:Name="GForceTestView" DataContext="{Binding Test}"/>
    </GroupBox>
  </StackPanel>
</UserControl>
