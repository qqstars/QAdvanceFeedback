bin/
obj/
.vs/
*.user

# lib/ is not committed - tools/fetch-simhub-refs.sh rebuilds it from a fresh clone (downloads the
# SimHub installer, extracts the reference assemblies with innounp). See README.md's "Building"
# section and tools/fetch-simhub-refs.sh's own header comment.
lib/

# Scratch/working directories a fetch or packaging run may create.
.simhub-refs-work/
.claude/
.github/

# Decompiled SimHub source used as the implementation reference. NEVER commit this: it is Wotever's
# own code verbatim, not ours, and publishing it would be a far more direct problem than publishing
# our derived implementation. Regenerate locally with ilspycmd against lib/SimHub.Plugins.dll if
# needed - see docs/reference/README.md.
docs/reference/*.cs
