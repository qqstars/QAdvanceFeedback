<UserControl x:Class="QAdvanceFeedback.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:QAdvanceFeedbackViews">
  <!-- The control SimHub's GetWPFSettingsControl returns (docs\full-mvvm-plan.md 3.3): a thin host for the
       settings page view, bound to the plugin's one SettingsPageViewModel (its DataContext, inherited). The
       whole page - tabs, Apply bar, banner, implicit styles - is Ui\Views\SettingsPageView.xaml. -->
  <v:SettingsPageView x:Name="Page"/>
</UserControl>
