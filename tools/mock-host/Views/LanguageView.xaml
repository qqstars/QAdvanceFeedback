<UserControl x:Class="MockHost.Views.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Plugin UI language" FontWeight="Bold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" MinWidth="320" HorizontalAlignment="Left" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="The plugin's settings page and ShakeIt effect editors switch at once. They are rebuilt, so edits on the settings page that were not applied are lost. The mock host's own tabs stay in English. The choice is kept for the next start (MockHost.Settings.json)." />
    </StackPanel>
</UserControl>
