<UserControl x:Class="QAdvanceFeedbackViews.WheelChannelPulseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:QAdvanceFeedbackControls"
             xmlns:v="clr-namespace:QAdvanceFeedbackViews">
  <!-- The Pulse group of a Wheel Lock / Wheel Slip tab, bound to a PulseViewModel (draft edits, Apply). -->
  <GroupBox Header="{v:Loc Group.Pulse}">
    <StackPanel>
      <!-- The switch sits on the tab's shared left edge, like every other control here; its caption stays
           a bold Header above, matching the Integrate feature switch. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="ChannelAlign"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{v:Loc Pulse.Enable}" TextWrapping="Wrap"/>
        <mah:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" HorizontalAlignment="Left" Margin="4"
                          OnLabel="{v:Loc GForce.Shake.On}" OffLabel="{v:Loc GForce.Shake.Off}"/>
      </Grid>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{v:Loc Pulse.GapMs}"/><local:NumericEditor Value="{Binding GapMs}" Minimum="200" Maximum="5000" Interval="50"/>
        <TextBlock Text="{v:Loc Pulse.MinValue}"/><local:NumericEditor Value="{Binding MinValue}"/>
      </StackPanel>
      <TextBlock Text="{v:Loc Pulse.FloorNote}" TextWrapping="Wrap" FontStyle="Italic"/>
    </StackPanel>
  </GroupBox>
</UserControl>
