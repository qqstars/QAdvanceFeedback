<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>QAdvanceFeedback.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link-compiled, NOT a ProjectReference: keeps the tests free of SimHub and enforces that
         Core\ has no SimHub dependencies at all - see QAdvanceFeedback\Core's own remarks. -->
    <Compile Include="..\QAdvanceFeedback\Core\**\*.cs" LinkBase="Core" />
    <!-- GForceSettings.cs specifically (not a Settings\**\*.cs wildcard): this task owns only that
         one file under Settings\, and a deliberately narrow, explicit Include avoids silently
         pulling in whatever the parallel WheelChannelSettings/persistence task adds to Settings\
         later. Also SimHub-free (only references QAdvanceFeedback.Core/.Core.GForce). -->
    <Compile Include="..\QAdvanceFeedback\Settings\GForceSettings.cs" LinkBase="Settings" />

    <!-- Layers 4/5 (WheelChannelSettings/persistence task): same narrow-Include convention as
         GForceSettings.cs above, for the same reason (this task owns only these specific files
         under Settings\, not the whole folder) - explicit files rather than a Settings\**\*.cs
         wildcard, so the two parallel tasks' Includes cannot silently collide. All SimHub-free
         (Newtonsoft round-trips them with no attributes; ConfigStore/RuntimeStore take logging as
         plain Action&lt;string&gt; delegates instead of a direct SimHub.Logging reference - see
         their own remarks), so persistence is tested against the REAL classes, real temp files
         included, not a re-implementation. -->
    <Compile Include="..\QAdvanceFeedback\Settings\WheelChannelSettings.cs" LinkBase="Settings" />
    <Compile Include="..\QAdvanceFeedback\Settings\ScriptType.cs" LinkBase="Settings" />
    <!-- SourceMode (the Manual/ShakeIt toggle, owner-requested) - WheelChannelSettings.cs (above)
         now references this enum. Core\ShakeIt\*.cs already arrives via the Core\**\*.cs wildcard. -->
    <Compile Include="..\QAdvanceFeedback\Settings\SourceMode.cs" LinkBase="Settings" />
    <Compile Include="..\QAdvanceFeedback\Settings\DefaultWheelSources.cs" LinkBase="Settings" />
    <Compile Include="..\QAdvanceFeedback\Settings\QAdvanceFeedbackSettings.cs" LinkBase="Settings" />
    <Compile Include="..\QAdvanceFeedback\ConfigStore.cs" LinkBase="Adapters" />
    <Compile Include="..\QAdvanceFeedback\RuntimeStore.cs" LinkBase="Adapters" />

    <!-- Wiring task's own additions (this task now owns composing every settings group into the
         plugin, so these are plain, direct Includes rather than continuing the narrow-per-task
         convention above, which existed only to keep concurrent parallel tasks from colliding). -->
    <Compile Include="..\QAdvanceFeedback\Settings\GeneralSettings.cs" LinkBase="Settings" />
    <Compile Include="..\QAdvanceFeedback\Settings\SourceButtonMode.cs" LinkBase="Settings" />
    <!-- AllPublishedProperties.cs and Core\Localization\*.cs already arrive via the Core\**\*.cs
         wildcard above - no separate Include needed (and would be a duplicate-Compile-item error). -->
    <Compile Include="..\QAdvanceFeedback\CsvExportWriter.cs" LinkBase="Adapters" />
  </ItemGroup>
  <ItemGroup>
    <!-- The plugin's withheld Layer 2/3 implementations (see ..\Private\README.md) now live in a
         single top-level ..\Private\QAdvanceFeedback\ folder beside the .sln (mirroring the
         plugin's own project name) instead of a Private\ folder inside the plugin's project
         directory. This project link-compiles the two SimHub-free algorithm files directly (NOT
         SimHubTelemetryAdapter.cs, which needs GameReaderCommon/SimHub types this test project
         deliberately does not reference) so its own withheld fidelity tests, immediately below,
         can exercise the real concrete classes without a ProjectReference to the plugin.
         Named explicitly (not a Private\QAdvanceFeedback\**\*.cs wildcard) because only these two
         of the three files there are safe to compile into this SimHub-free assembly; each is
         still individually Exists()-guarded so a clean clone with the folder absent still builds
         this test project (0 errors) with just those two Compile items contributing nothing. -->
    <Compile Include="..\Private\QAdvanceFeedback\LegacySlipAlgorithm.cs" LinkBase="Core"
             Condition="Exists('..\Private\QAdvanceFeedback\LegacySlipAlgorithm.cs')" />
    <Compile Include="..\Private\QAdvanceFeedback\LegacyWheelLockSlipEngine.cs" LinkBase="Core"
             Condition="Exists('..\Private\QAdvanceFeedback\LegacyWheelLockSlipEngine.cs')" />
    <!-- Lock-and-animation task's own addition (docs\lock-and-animation-report.md) - the Wheel Lock
         channel's corrected Layer 3 algorithm (SimHub's "Braking vs speed" branch, faithfully ported,
         plus the documented low-speed fix). Same Exists()-guard convention as the two files above. -->
    <Compile Include="..\Private\QAdvanceFeedback\SimpleBrakingLockAlgorithm.cs" LinkBase="Core"
             Condition="Exists('..\Private\QAdvanceFeedback\SimpleBrakingLockAlgorithm.cs')" />
  </ItemGroup>
  <ItemGroup>
    <!-- This project's OWN withheld fidelity tests (see ..\Private\README.md) now live in a
         single top-level ..\Private\QAdvanceFeedback.Tests\ folder beside the .sln, instead of a
         Private\ folder inside this project's own directory. Because it is now OUTSIDE this
         project's directory, the SDK's default `**\*.cs` glob no longer finds it automatically
         (it used to, when Private\ was nested inside this project), so it needs this explicit
         Include - the equivalent of the plugin project's own Include above. This wildcard
         evaluates to an empty item list (not a build error) when
         ..\Private\QAdvanceFeedback.Tests\ is completely absent - the state of a fresh clone - so
         every other test in this project still builds and passes without it. `Link` re-parents
         the files under a virtual "Private" folder in Solution Explorer instead of flattening
         them at the project root. -->
    <Compile Include="..\Private\QAdvanceFeedback.Tests\**\*.cs"
             Link="Private\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Only for the Newtonsoft-serialised Settings/Runtime POCOs and the two link-compiled
         ConfigStore/RuntimeStore adapter files above - not used by anything in Core\'s own
         algorithm files. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
