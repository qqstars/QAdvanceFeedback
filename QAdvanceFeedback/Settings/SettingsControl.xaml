<UserControl x:Class="QAdvanceFeedback.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinWidth" Value="160"/>
    </Style>

    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
      <Setter Property="Margin" Value="8"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="4"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="4"/>
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style TargetType="mah:NumericUpDown" BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Width" Value="80"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Interval" Value="1"/>
      <Setter Property="StringFormat" Value="0.#"/>
      <Setter Property="InterceptArrowKeys" Value="True"/>
      <Setter Property="InterceptMouseWheel" Value="True"/>
    </Style>

    <!-- Per-source script-type indicator/toggle. One shared style; each button's fill (gradient) and
         letter ("J"/"N") are set imperatively from code-behind (SetScriptTypeVisual), since which of
         the two states a given field is in is per-instance runtime state. A real Button, not a Shape
         with a click handler bolted on, so it is keyboard-focusable and activates on Space/Enter. -->
    <Style x:Key="ScriptTypeToggleButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="4,4,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ScriptTypeBorder" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#55000000" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="BorderBrush" Value="Black"/>
                <Setter TargetName="ScriptTypeBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,8,8,0">
      <Button x:Name="ApplyButton" Padding="16,4" IsEnabled="False"/>
      <Button x:Name="RestoreAllDefaultsButton" Padding="16,4"/>
    </StackPanel>

    <TabControl x:Name="MainTabs">

      <!-- ================================================================================ -->
      <TabItem x:Name="WheelLockTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Grid.IsSharedSizeScope="True">
            <!-- TRIGGER THRESHOLD - owner-requested restructure: promoted out of "Sources" into its
                 own section, ABOVE Sources, on both the Wheel Lock and Wheel Slip tabs (see
                 docs\lock-and-animation-report.md). Gates the WHOLE channel (Raw AND Normalized), not
                 just the underlying algorithm's own per-wheel term - see the note text/localisation for
                 the exact semantics, including the ShakeIt-source composition caveat. -->
            <GroupBox x:Name="LockTriggerThresholdGroup">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblBrakeThreshold"/>
                  <mah:NumericUpDown x:Name="LockBrakeThreshold" StringFormat="0"/>
                </StackPanel>
                <TextBlock x:Name="LockThresholdNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <!-- LockSensibility (docs\lock-and-animation-report.md) - matches SimHub's own
                     WheelsLockContainer.LockSensibility exactly (name, range 0-100, default 50); now
                     load-bearing for Lock's own corrected Layer 3 algorithm. -->
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblSensibility"/>
                  <mah:NumericUpDown x:Name="LockSensibility" StringFormat="0"/>
                </StackPanel>
                <TextBlock x:Name="LockSensibilityNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="LockSourcesGroup">
              <StackPanel>
                <!-- Source mode toggle - ALWAYS at the top of this section, ALWAYS visible and
                     switchable regardless of whether ShakeIt Motors is currently reporting the four
                     expected properties (see SettingsControl.xaml.cs's own remarks on why this used to
                     be hidden, and why that was wrong). -->
                <StackPanel x:Name="LockSourceModePanel" Orientation="Horizontal">
                  <TextBlock x:Name="LockLblSourceMode"/>
                  <ComboBox x:Name="LockSourceModeCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="LockSourceModeManual" Tag="Manual"/>
                    <ComboBoxItem x:Name="LockSourceModeShakeIt" Tag="ShakeIt"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="LockShakeItSetupNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="LockSourcesShakeItNote" TextWrapping="Wrap" FontStyle="Italic" Foreground="DarkOrange"/>
                <TextBlock x:Name="LockManualNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <TextBlock x:Name="LockSourcesNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="LockSourcesContractNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LockLblFrontLeft"/>
                  <Button    Grid.Row="0" Grid.Column="1" x:Name="LockScriptTypeFl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="0" Grid.Column="2" x:Name="LockSourceFl"/>
                  <Button    Grid.Row="0" Grid.Column="3" x:Name="LockPickFl"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LockLblFrontRight"/>
                  <Button    Grid.Row="1" Grid.Column="1" x:Name="LockScriptTypeFr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="1" Grid.Column="2" x:Name="LockSourceFr"/>
                  <Button    Grid.Row="1" Grid.Column="3" x:Name="LockPickFr"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LockLblRearLeft"/>
                  <Button    Grid.Row="2" Grid.Column="1" x:Name="LockScriptTypeRl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="2" Grid.Column="2" x:Name="LockSourceRl"/>
                  <Button    Grid.Row="2" Grid.Column="3" x:Name="LockPickRl"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LockLblRearRight"/>
                  <Button    Grid.Row="3" Grid.Column="1" x:Name="LockScriptTypeRr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="3" Grid.Column="2" x:Name="LockSourceRr"/>
                  <Button    Grid.Row="3" Grid.Column="3" x:Name="LockPickRr"/>
                </Grid>
                <Button x:Name="LockResetSources" Padding="16,4" HorizontalAlignment="Left"/>

                <!-- KEY DATA POINTS (v1.0.7.2). Four columns, one Grid, so labels / controls / learned
                     hints / descriptions all line up down the section. The learned-value hint has its own
                     fixed-width monospace column precisely so "10.5" and "9.3" align. -->
                <TextBlock x:Name="LockKeyDataHeader" FontWeight="Bold" Margin="4,14,4,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LockAlign"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock     Grid.Row="0" Grid.Column="0" x:Name="LockKeyDataAutoLabel"/>
                  <mah:ToggleSwitch  Grid.Row="0" Grid.Column="1" x:Name="LockKeyDataAutoToggle" HorizontalAlignment="Left" Margin="4"/>
                  <TextBlock     Grid.Row="0" Grid.Column="3" x:Name="LockKeyDataAutoDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock     Grid.Row="1" Grid.Column="0" x:Name="LockKeyDataPerGameLabel"/>
                  <mah:ToggleSwitch  Grid.Row="1" Grid.Column="1" x:Name="LockKeyDataPerGameToggle" HorizontalAlignment="Left" Margin="4"/>
                  <TextBlock     Grid.Row="1" Grid.Column="3" x:Name="LockKeyDataPerGameDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="2" Grid.Column="0" x:Name="LockKeyDataSMaxLabel"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="LockKeyDataSMax" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="2" Grid.Column="2" x:Name="LockKeyDataSMaxLearned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="2" Grid.Column="3" x:Name="LockKeyDataSMaxDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="3" Grid.Column="0" x:Name="LockKeyDataS90Label"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LockKeyDataS90" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="3" Grid.Column="2" x:Name="LockKeyDataS90Learned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="3" Grid.Column="3" x:Name="LockKeyDataS90Desc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="4" Grid.Column="0" x:Name="LockKeyDataS75Label"/>
                  <mah:NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="LockKeyDataS75" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="4" Grid.Column="2" x:Name="LockKeyDataS75Learned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="4" Grid.Column="3" x:Name="LockKeyDataS75Desc" TextWrapping="Wrap" FontStyle="Italic"/>
                </Grid>
                <!-- Manual mode only - under Auto there is nothing for a driver to reset, since the
                     values are whatever the plugin has learned. -->
                <Button x:Name="LockKeyDataReset" Padding="16,4" HorizontalAlignment="Left"/>
                <TextBlock x:Name="LockKeyDataStatus" TextWrapping="Wrap" FontStyle="Italic" Foreground="#C62828" Margin="4,4,4,0"/>

              </StackPanel>
            </GroupBox>

            <!-- AGGREGATION (docs\aggregation-report.md) - the owner's physically-motivated Max/Min
                 axle blend + Front/Rear weight-transfer scheme that combines the four wheels above into
                 Front/Rear/Left/Right/All, replacing the previous generic aggregation. Every weight is
                 independently configurable per channel (Wheel Lock has no slip-floor control - see
                 SlipAggregationGroup below for that one). -->
            <GroupBox x:Name="LockAggregationGroup">
              <StackPanel>
                <TextBlock x:Name="LockAggregationNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LockAlign"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LockLblWMax"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="LockWMax" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LockLblWMin"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="LockWMin" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LockLblWFront"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="LockWFront" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LockLblWRear"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LockWRear" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>
                </Grid>

                <TextBlock x:Name="LockAggregationAxleHelp" TextWrapping="Wrap" FontStyle="Italic" Margin="4,8,4,0"/>
                <TextBlock x:Name="LockAggregationSideHelp" TextWrapping="Wrap" FontStyle="Italic" Margin="4,4,4,4"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="LockCurveGroup">
              <StackPanel>
                <!-- 1.0.6.0 (docs\release-1060-report.md, Part 2's UI half) - Wheel Lock ONLY, at the
                     TOP of this section; Wheel Slip has no equivalent control at all. -->
                <!-- ONE GRID so the two dropdowns line up (owner: "vertical align the DropDown of
                     Normalize Pattern and Preset") - separate StackPanels sized their labels
                     independently, so the combos started at different x positions. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LockAlign"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LockLblNormalizePattern"/>
                  <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="LockNormalizePatternCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="LockNormalizePatternMaxGripOnly" Tag="MaxGripOnly"/>
                    <ComboBoxItem x:Name="LockNormalizePatternMapping" Tag="Mapping"/>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LockNormalizePatternDesc" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,8"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LockLblPreset"/>
                  <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="LockPresetCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="LockPresetLinear" Tag="Linear"/>
                    <ComboBoxItem x:Name="LockPresetCurve" Tag="Curve"/>
                    <ComboBoxItem x:Name="LockPresetLinearCustom" Tag="LinearCustom"/>
                    <ComboBoxItem x:Name="LockPresetCurveCustom" Tag="CurveCustom"/>
                    <ComboBoxItem x:Name="LockPresetCustom" Tag="Custom"/>
                  </ComboBox>
                </Grid>

                <TextBlock x:Name="LockAnchorNoteText" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LockAlign"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LockColRawHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LockColOutputHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LockColFlattenRangeHeader" HorizontalAlignment="Center" FontWeight="Bold"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LockLblStart" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="LockStartRaw"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="LockStartOutput" Minimum="0" Maximum="100" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LockDescStart" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LockLblSlightly" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LockSlightlyRaw"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="2" x:Name="LockSlightlyOutput"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="3" x:Name="LockSlightlyFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="3" Grid.Column="4" x:Name="LockLiveSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LockDescSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" x:Name="LockLblModerate" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="LockModerateRaw"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="2" x:Name="LockModerateOutput"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="3" x:Name="LockModerateFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="5" Grid.Column="4" x:Name="LockLiveModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LockDescModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" x:Name="LockLblCritical" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="1" x:Name="LockCriticalRaw"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="2" x:Name="LockCriticalOutput"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="3" x:Name="LockCriticalFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="7" Grid.Column="4" x:Name="LockLiveCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LockDescCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="9" Grid.Column="0" x:Name="LockLblEnd" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="1" x:Name="LockEndRaw"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="2" x:Name="LockEndOutput" Minimum="0" Maximum="100" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LockDescEnd" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>
                </Grid>

                <!-- TWO GRAPHS SIDE BY SIDE (1.0.7.0). Left: what the curve rows above configure
                     (normalized value -> final projected). Right: the whole chain a driver actually
                     feels, source value -> projected, sampled every 5 and joined - there is no single
                     closed form for it, since the key data points and the curve compose. Decorations
                     (grid, ticks, key-point markers) are drawn in code so they track the live settings;
                     see RenderGraphDecorations. -->
                <StackPanel Orientation="Horizontal" Margin="4,8,4,0">
                  <StackPanel>
                    <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                      <Canvas x:Name="LockCurveCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                        <Polyline x:Name="LockCurvePolyline" Stroke="DodgerBlue" StrokeThickness="2"/>
                        <Ellipse x:Name="LockStartMarker" Width="8" Height="8" Fill="Gray"/>
                        <Ellipse x:Name="LockSlightlyMarker" Width="8" Height="8" Fill="Orange"/>
                        <Ellipse x:Name="LockModerateMarker" Width="8" Height="8" Fill="DodgerBlue"/>
                        <Ellipse x:Name="LockCriticalMarker" Width="8" Height="8" Fill="Red"/>
                        <Ellipse x:Name="LockEndMarker" Width="8" Height="8" Fill="Gray"/>
                      </Canvas>
                    </Border>
                    <TextBlock x:Name="LockCurveGraphCaption" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Margin="12,0,0,0">
                    <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                      <Canvas x:Name="LockSourceCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                        <Polyline x:Name="LockSourcePolyline" Stroke="Green" StrokeThickness="2" StrokeDashArray="6 3"/>
                      </Canvas>
                    </Border>
                    <TextBlock x:Name="LockSourceGraphCaption" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="LockPulseGroup">
              <StackPanel>
                <!-- The switch sits on the tab's shared left edge, like every other control here;
                     its caption stays a bold Header above, matching the Integrate feature switch. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LockAlign"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="LockPulseEnabledLabel" TextWrapping="Wrap"/>
                  <mah:ToggleSwitch Grid.Column="1" x:Name="LockPulseEnabled" HorizontalAlignment="Left" Margin="4"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblGapMs"/><mah:NumericUpDown x:Name="LockPulseGapMs" Minimum="200" Maximum="5000" Interval="50"/>
                  <TextBlock x:Name="LockLblMinValue"/><mah:NumericUpDown x:Name="LockPulseMinValue"/>
                </StackPanel>
                <TextBlock x:Name="LockPulseFloorNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="WheelSlipTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Grid.IsSharedSizeScope="True">
            <!-- TRIGGER THRESHOLD - see LockTriggerThresholdGroup's own remarks; identical layout,
                 independently for this channel (brake AND throttle, brake-priority unchanged). -->
            <GroupBox x:Name="SlipTriggerThresholdGroup">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblBrakeThreshold"/>
                  <mah:NumericUpDown x:Name="SlipBrakeThreshold" StringFormat="0"/>
                  <TextBlock x:Name="SlipLblThrottleThreshold"/>
                  <mah:NumericUpDown x:Name="SlipThrottleThreshold" StringFormat="0"/>
                </StackPanel>
                <TextBlock x:Name="SlipThresholdNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SlipSourcesGroup">
              <StackPanel>
                <!-- Source mode toggle - see LockSourcesGroup's own remarks; identical layout/logic,
                     independently for this channel. -->
                <StackPanel x:Name="SlipSourceModePanel" Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblSourceMode"/>
                  <ComboBox x:Name="SlipSourceModeCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="SlipSourceModeManual" Tag="Manual"/>
                    <ComboBoxItem x:Name="SlipSourceModeShakeIt" Tag="ShakeIt"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="SlipShakeItSetupNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="SlipSourcesShakeItNote" TextWrapping="Wrap" FontStyle="Italic" Foreground="DarkOrange"/>
                <TextBlock x:Name="SlipManualNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <TextBlock x:Name="SlipSourcesNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="SlipSourcesContractNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SlipLblFrontLeft"/>
                  <Button    Grid.Row="0" Grid.Column="1" x:Name="SlipScriptTypeFl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="0" Grid.Column="2" x:Name="SlipSourceFl"/>
                  <Button    Grid.Row="0" Grid.Column="3" x:Name="SlipPickFl"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SlipLblFrontRight"/>
                  <Button    Grid.Row="1" Grid.Column="1" x:Name="SlipScriptTypeFr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="1" Grid.Column="2" x:Name="SlipSourceFr"/>
                  <Button    Grid.Row="1" Grid.Column="3" x:Name="SlipPickFr"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SlipLblRearLeft"/>
                  <Button    Grid.Row="2" Grid.Column="1" x:Name="SlipScriptTypeRl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="2" Grid.Column="2" x:Name="SlipSourceRl"/>
                  <Button    Grid.Row="2" Grid.Column="3" x:Name="SlipPickRl"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SlipLblRearRight"/>
                  <Button    Grid.Row="3" Grid.Column="1" x:Name="SlipScriptTypeRr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="3" Grid.Column="2" x:Name="SlipSourceRr"/>
                  <Button    Grid.Row="3" Grid.Column="3" x:Name="SlipPickRr"/>
                </Grid>
                <Button x:Name="SlipResetSources" Padding="16,4" HorizontalAlignment="Left"/>

                <!-- KEY DATA POINTS (v1.0.7.2). Four columns, one Grid, so labels / controls / learned
                     hints / descriptions all line up down the section. The learned-value hint has its own
                     fixed-width monospace column precisely so "10.5" and "9.3" align. -->
                <TextBlock x:Name="SlipKeyDataHeader" FontWeight="Bold" Margin="4,14,4,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SlipAlign"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock     Grid.Row="0" Grid.Column="0" x:Name="SlipKeyDataAutoLabel"/>
                  <mah:ToggleSwitch  Grid.Row="0" Grid.Column="1" x:Name="SlipKeyDataAutoToggle" HorizontalAlignment="Left" Margin="4"/>
                  <TextBlock     Grid.Row="0" Grid.Column="3" x:Name="SlipKeyDataAutoDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock     Grid.Row="1" Grid.Column="0" x:Name="SlipKeyDataPerGameLabel"/>
                  <mah:ToggleSwitch  Grid.Row="1" Grid.Column="1" x:Name="SlipKeyDataPerGameToggle" HorizontalAlignment="Left" Margin="4"/>
                  <TextBlock     Grid.Row="1" Grid.Column="3" x:Name="SlipKeyDataPerGameDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="2" Grid.Column="0" x:Name="SlipKeyDataSMaxLabel"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="SlipKeyDataSMax" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="2" Grid.Column="2" x:Name="SlipKeyDataSMaxLearned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="2" Grid.Column="3" x:Name="SlipKeyDataSMaxDesc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="3" Grid.Column="0" x:Name="SlipKeyDataS90Label"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="SlipKeyDataS90" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="3" Grid.Column="2" x:Name="SlipKeyDataS90Learned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="3" Grid.Column="3" x:Name="SlipKeyDataS90Desc" TextWrapping="Wrap" FontStyle="Italic"/>

                  <TextBlock         Grid.Row="4" Grid.Column="0" x:Name="SlipKeyDataS75Label"/>
                  <mah:NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="SlipKeyDataS75" Minimum="0" Maximum="100" Interval="0.5" StringFormat="0.0" mah:TextBoxHelper.Watermark="---"/>
                  <TextBlock         Grid.Row="4" Grid.Column="2" x:Name="SlipKeyDataS75Learned" FontFamily="Consolas" Width="150"/>
                  <TextBlock         Grid.Row="4" Grid.Column="3" x:Name="SlipKeyDataS75Desc" TextWrapping="Wrap" FontStyle="Italic"/>
                </Grid>
                <!-- Manual mode only - under Auto there is nothing for a driver to reset, since the
                     values are whatever the plugin has learned. -->
                <Button x:Name="SlipKeyDataReset" Padding="16,4" HorizontalAlignment="Left"/>
                <TextBlock x:Name="SlipKeyDataStatus" TextWrapping="Wrap" FontStyle="Italic" Foreground="#C62828" Margin="4,4,4,0"/>

              </StackPanel>
            </GroupBox>

            <!-- AGGREGATION - see LockAggregationGroup's own remarks; identical layout, independently
                 for this channel, PLUS the slip floor factor (Wheel Lock has no equivalent control - see
                 docs\aggregation-report.md for why Lock does not need one). -->
            <GroupBox x:Name="SlipAggregationGroup">
              <StackPanel>
                <TextBlock x:Name="SlipAggregationNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SlipAlign"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SlipLblWMax"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="SlipWMax" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SlipLblWMin"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="SlipWMin" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SlipLblWFront"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="SlipWFront" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SlipLblWRear"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="SlipWRear" Minimum="0" Maximum="2" Interval="0.05" StringFormat="0.00"/>
                </Grid>

                <TextBlock x:Name="SlipAggregationAxleHelp" TextWrapping="Wrap" FontStyle="Italic" Margin="4,8,4,0"/>
                <TextBlock x:Name="SlipAggregationSideHelp" TextWrapping="Wrap" FontStyle="Italic" Margin="4,4,4,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock x:Name="SlipLblFloorFactor"/>
                  <mah:NumericUpDown x:Name="SlipFloorFactor" Minimum="0" Maximum="1" Interval="0.05" StringFormat="0.00"/>
                </StackPanel>
                <TextBlock x:Name="SlipFloorFactorNote" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,4"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SlipCurveGroup">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SlipAlign"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- SLIP NOW HAS A PATTERN DROPDOWN TOO (v1.0.7.2). Its two entries are named for what
                       Slip actually measures - Best Point Only / Perfect-Great-Good - rather than the
                       grip-percentage names Lock uses. -->
                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SlipLblNormalizePattern"/>
                  <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SlipNormalizePatternCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="SlipNormalizePatternMaxGripOnly" Tag="MaxGripOnly"/>
                    <ComboBoxItem x:Name="SlipNormalizePatternMapping" Tag="Mapping"/>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SlipNormalizePatternDesc" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,8"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SlipLblPreset"/>
                  <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="SlipPresetCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="SlipPresetLinear" Tag="Linear"/>
                    <ComboBoxItem x:Name="SlipPresetCurve" Tag="Curve"/>
                    <ComboBoxItem x:Name="SlipPresetLinearCustom" Tag="LinearCustom"/>
                    <ComboBoxItem x:Name="SlipPresetCurveCustom" Tag="CurveCustom"/>
                    <ComboBoxItem x:Name="SlipPresetCustom" Tag="Custom"/>
                  </ComboBox>
                </Grid>

                <TextBlock x:Name="SlipAnchorNoteText" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SlipAlign"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SlipColRawHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SlipColOutputHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="3" x:Name="SlipColFlattenRangeHeader" HorizontalAlignment="Center" FontWeight="Bold"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SlipLblStart" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="SlipStartRaw"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="SlipStartOutput" Minimum="0" Maximum="100" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" x:Name="SlipDescStart" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SlipLblSlightly" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="SlipSlightlyRaw"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="2" x:Name="SlipSlightlyOutput"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="3" x:Name="SlipSlightlyFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="3" Grid.Column="4" x:Name="SlipLiveSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" x:Name="SlipDescSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" x:Name="SlipLblModerate" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="SlipModerateRaw"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="2" x:Name="SlipModerateOutput"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="3" x:Name="SlipModerateFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="5" Grid.Column="4" x:Name="SlipLiveModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" x:Name="SlipDescModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" x:Name="SlipLblCritical" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="1" x:Name="SlipCriticalRaw"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="2" x:Name="SlipCriticalOutput"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="3" x:Name="SlipCriticalFlattenRange" Minimum="0" Maximum="15" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="7" Grid.Column="4" x:Name="SlipLiveCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" x:Name="SlipDescCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="9" Grid.Column="0" x:Name="SlipLblEnd" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="1" x:Name="SlipEndRaw"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="2" x:Name="SlipEndOutput" Minimum="0" Maximum="100" Interval="1" StringFormat="0"/>
                  <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="5" x:Name="SlipDescEnd" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>
                </Grid>

                <!-- TWO GRAPHS SIDE BY SIDE (1.0.7.0). Left: what the curve rows above configure
                     (normalized value -> final projected). Right: the whole chain a driver actually
                     feels, source value -> projected, sampled every 5 and joined - there is no single
                     closed form for it, since the key data points and the curve compose. Decorations
                     (grid, ticks, key-point markers) are drawn in code so they track the live settings;
                     see RenderGraphDecorations. -->
                <StackPanel Orientation="Horizontal" Margin="4,8,4,0">
                  <StackPanel>
                    <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                      <Canvas x:Name="SlipCurveCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                        <Polyline x:Name="SlipCurvePolyline" Stroke="DodgerBlue" StrokeThickness="2"/>
                        <Ellipse x:Name="SlipStartMarker" Width="8" Height="8" Fill="Gray"/>
                        <Ellipse x:Name="SlipSlightlyMarker" Width="8" Height="8" Fill="Orange"/>
                        <Ellipse x:Name="SlipModerateMarker" Width="8" Height="8" Fill="DodgerBlue"/>
                        <Ellipse x:Name="SlipCriticalMarker" Width="8" Height="8" Fill="Red"/>
                        <Ellipse x:Name="SlipEndMarker" Width="8" Height="8" Fill="Gray"/>
                      </Canvas>
                    </Border>
                    <TextBlock x:Name="SlipCurveGraphCaption" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Margin="12,0,0,0">
                    <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                      <Canvas x:Name="SlipSourceCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                        <Polyline x:Name="SlipSourcePolyline" Stroke="Green" StrokeThickness="2" StrokeDashArray="6 3"/>
                      </Canvas>
                    </Border>
                    <TextBlock x:Name="SlipSourceGraphCaption" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SlipPulseGroup">
              <StackPanel>
                <!-- The switch sits on the tab's shared left edge, like every other control here;
                     its caption stays a bold Header above, matching the Integrate feature switch. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SlipAlign"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="SlipPulseEnabledLabel" TextWrapping="Wrap"/>
                  <mah:ToggleSwitch Grid.Column="1" x:Name="SlipPulseEnabled" HorizontalAlignment="Left" Margin="4"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblGapMs"/><mah:NumericUpDown x:Name="SlipPulseGapMs" Minimum="200" Maximum="5000" Interval="50"/>
                  <TextBlock x:Name="SlipLblMinValue"/><mah:NumericUpDown x:Name="SlipPulseMinValue"/>
                </StackPanel>
                <TextBlock x:Name="SlipPulseFloorNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="GForceTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Grid.IsSharedSizeScope="True">
            <GroupBox x:Name="GForceMaximaGroup">
              <StackPanel>
                <TextBlock x:Name="GForceMaximaNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <!-- ONE GRID, so the two rows line up column-for-column (owner: "align the maximum
                     acc G and break G vertically"). Two StackPanels could not - each sized its own
                     label independently, so the toggles and value boxes never lined up. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock          Grid.Row="0" Grid.Column="0" x:Name="GForceLblAccelMax"/>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="GForceAccelAutoLabel"/>
                    <mah:ToggleSwitch x:Name="GForceAccelAutoToggle" Margin="4"/>
                  </StackPanel>
                  <mah:NumericUpDown  Grid.Row="0" Grid.Column="2" x:Name="GForceFixedAccelMax" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
                  <TextBlock          Grid.Row="0" Grid.Column="3" x:Name="GForceAccelLearnedText" TextWrapping="Wrap"/>

                  <TextBlock          Grid.Row="1" Grid.Column="0" x:Name="GForceLblDecelMax"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="GForceDecelAutoLabel"/>
                    <mah:ToggleSwitch x:Name="GForceDecelAutoToggle" Margin="4"/>
                  </StackPanel>
                  <mah:NumericUpDown  Grid.Row="1" Grid.Column="2" x:Name="GForceFixedDecelMax" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
                  <TextBlock          Grid.Row="1" Grid.Column="3" x:Name="GForceDecelLearnedText" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock x:Name="GForceRecommendedHzText" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceSustainGroup">
              <StackPanel>
                <TextBlock x:Name="GForceSustainNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblBrakeBottomRear"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceBrakeBottomRearSustain"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblBrakeBackLow"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceBrakeBackLowSustain"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblAccelBottomRear"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceAccelBottomRearSustain"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblAccelBackLow"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="GForceAccelBackLowSustain"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceMotionGroup">
              <StackPanel>
                <TextBlock x:Name="GForceMotionNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblSustainTau"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceSustainTau" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblTransientTau"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceTransientTau" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblTransientGain"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceTransientGain" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.0"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblAutoTransitionScale"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="GForceAutoTransitionScale" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.00"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" x:Name="GForceLblFixedTransitionScale"/>
                  <mah:NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="GForceFixedTransitionScale" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.00"/>
                </Grid>
                <TextBlock x:Name="GForceTransitionScaleNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceLateralGroup">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="GForceLblLateralDirection"/>
                  <ComboBox Grid.Column="1" x:Name="GForceLateralDirectionCombo">
                    <ComboBoxItem x:Name="GForceLateralNormal" Tag="Normal"/>
                    <ComboBoxItem x:Name="GForceLateralReversed" Tag="Reversed"/>
                  </ComboBox>
                </Grid>
                <TextBlock x:Name="GForceLateralDirectionNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceShakeGroup">
              <StackPanel>
                <!-- A feature SWITCH, not a minor checkbox option (owner's explicit distinction) -
                     a prominent MahApps ToggleSwitch, sitting above the settings it governs, with
                     both states spelled out via OnLabel/OffLabel (never inferred from a highlight
                     alone) and a bold header naming the feature. -->
                <TextBlock x:Name="GForceShakeHeader" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
                <mah:ToggleSwitch x:Name="GForceShakeEnabled" HorizontalAlignment="Left" Margin="4,2,4,8"/>
                <TextBlock x:Name="GForceShakeNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GForceAlign"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblShakeFrequency"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceShakeFrequency" Minimum="1" Maximum="20" Interval="1" StringFormat="0.#"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblShakeLockScale"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceShakeLockScale" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblShakeSlipScale"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceShakeSlipScale" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="GeneralTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox x:Name="GeneralGroup">
              <StackPanel>
                <TextBlock x:Name="EnableDiagnosticsHeader" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
                <mah:ToggleSwitch x:Name="EnableDiagnosticsCheckBox" HorizontalAlignment="Left"/>
                <TextBlock x:Name="EnableDiagnosticsNote" TextWrapping="Wrap" FontStyle="Italic" Margin="20,0,4,4"/>
                <TextBlock x:Name="EnableDiagnosticsRestartNote" TextWrapping="Wrap" FontWeight="Bold" Margin="20,0,4,8"/>

                <TextBlock x:Name="ExportCsvHeader" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
                <mah:ToggleSwitch x:Name="ExportCsvCheckBox" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ExportCsvNote" TextWrapping="Wrap" FontStyle="Italic" Margin="20,0,4,4"/>

                <!-- 1.0.6.0 (docs\release-1060-report.md, Part 4f) - read from the running assembly's
                     own version at display time (SettingsControl.xaml.cs's LocalizeStaticText), never
                     hardcoded, so this label can never drift from the DLL actually loaded. -->
                <TextBlock x:Name="GeneralVersionText" TextWrapping="Wrap" Margin="4,8,4,4"/>
              </StackPanel>
            </GroupBox>

            <!-- SHAKEIT REFERENCE DATA IMPORT (1.0.7.1). Layer 3 reproduces ShakeIt's arithmetic
                 exactly; the one input we cannot ship is SimHub's own precalibration file. Importing it
                 from the local SimHub installation is what makes our Raw values and ShakeIt's agree by
                 construction - see ShakeItPrecalibrationConverter. -->
            <GroupBox x:Name="ShakeItImportGroup">
              <StackPanel>
                <TextBlock x:Name="ShakeItImportNote" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,6"/>
                <TextBlock x:Name="ShakeItImportOverrideHeader" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
                <mah:ToggleSwitch x:Name="ShakeItImportOverrideCheckBox" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ShakeItImportOverrideNote" TextWrapping="Wrap" FontStyle="Italic" Margin="20,0,4,6"/>
                <Button x:Name="ShakeItImportButton" HorizontalAlignment="Left" Margin="4,0,4,4" Padding="8,2"/>
                <TextBlock x:Name="ShakeItImportResultText" TextWrapping="Wrap" Margin="4,4,4,4" Visibility="Collapsed"/>
              </StackPanel>
            </GroupBox>

            <!-- Plugin health section - see Core.Health.HealthRegistry and SettingsControl.xaml.cs's
                 RefreshHealthUi. Invisible/one-line when nothing is wrong, so it adds no clutter in the
                 normal case; expands to one warning block per degraded subsystem otherwise. -->
            <GroupBox x:Name="HealthGroup">
              <StackPanel>
                <TextBlock x:Name="HealthAllGoodText" TextWrapping="Wrap" Margin="4,0,4,4"/>
                <StackPanel x:Name="HealthIssuesPanel"/>
                <Button x:Name="HealthCopyDetailsButton" HorizontalAlignment="Left" Margin="4,4,4,4" Padding="8,2"/>
                <TextBlock x:Name="HealthCopyDetailsDoneText" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,4" Visibility="Collapsed"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</UserControl>
