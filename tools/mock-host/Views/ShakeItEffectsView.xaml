<UserControl x:Class="MockHost.Views.ShakeItEffectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MockHost.Views">
    <UserControl.Resources>
        <views:EffectEditorConverter x:Key="EffectEditor" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SimHub's effect list, in miniature -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Effect type" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding EffectTypes}" SelectedItem="{Binding SelectedEffectType}" DisplayMemberPath="Name" />
                <TextBlock Text="{Binding SelectedEffectType.Description}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,8" />
                <Button Content="Add Effect" Command="{Binding AddEffectCommand}" HorizontalAlignment="Left" MinWidth="120" />
                <TextBlock Text="Effects" Margin="0,16,0,4" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="Remove Effect" Command="{Binding RemoveEffectCommand}" HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,8" />
                <TextBlock Text="{Binding ProfilePath, StringFormat=Profile: {0}}" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="Header" />
        </DockPanel>

        <!-- The selected effect's editor: SimHub's header (name / enabled / gain), then the plugin's own editor -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel DataContext="{Binding SelectedEffect}" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,12,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                             Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Text="Enabled" VerticalAlignment="Center" Margin="0,0,12,4" />
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsEnabled}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Text="Gain" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Gain}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Gain, StringFormat={}{0:0}%}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="SimHub's own output, frequency and channel settings are not part of the mock host."
                           Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ContentControl Content="{Binding Container, Converter={StaticResource EffectEditor}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
