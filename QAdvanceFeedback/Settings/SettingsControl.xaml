<UserControl x:Class="QAdvanceFeedback.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinWidth" Value="160"/>
    </Style>

    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
      <Setter Property="Margin" Value="8"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="4"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="4"/>
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style TargetType="mah:NumericUpDown" BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Width" Value="80"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Interval" Value="1"/>
      <Setter Property="StringFormat" Value="0.#"/>
      <Setter Property="InterceptArrowKeys" Value="True"/>
      <Setter Property="InterceptMouseWheel" Value="True"/>
    </Style>

    <!-- Per-source script-type indicator/toggle. One shared style; each button's fill (gradient) and
         letter ("J"/"N") are set imperatively from code-behind (SetScriptTypeVisual), since which of
         the two states a given field is in is per-instance runtime state. A real Button, not a Shape
         with a click handler bolted on, so it is keyboard-focusable and activates on Space/Enter. -->
    <Style x:Key="ScriptTypeToggleButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="4,4,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ScriptTypeBorder" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#55000000" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ScriptTypeBorder" Property="BorderBrush" Value="Black"/>
                <Setter TargetName="ScriptTypeBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,8,8,0">
      <Button x:Name="ApplyButton" Padding="16,4"/>
      <Button x:Name="RestoreAllDefaultsButton" Padding="16,4"/>
    </StackPanel>

    <TabControl x:Name="MainTabs">

      <!-- ================================================================================ -->
      <TabItem x:Name="WheelLockTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox x:Name="LockSourcesGroup">
              <StackPanel>
                <!-- Source mode toggle - ALWAYS at the top of this section, ALWAYS visible and
                     switchable regardless of whether ShakeIt Motors is currently reporting the four
                     expected properties (see SettingsControl.xaml.cs's own remarks on why this used to
                     be hidden, and why that was wrong). -->
                <StackPanel x:Name="LockSourceModePanel" Orientation="Horizontal">
                  <TextBlock x:Name="LockLblSourceMode"/>
                  <ComboBox x:Name="LockSourceModeCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="LockSourceModeManual" Tag="Manual"/>
                    <ComboBoxItem x:Name="LockSourceModeShakeIt" Tag="ShakeIt"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="LockShakeItSetupNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="LockSourcesShakeItNote" TextWrapping="Wrap" FontStyle="Italic" Foreground="DarkOrange"/>
                <TextBlock x:Name="LockManualNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <TextBlock x:Name="LockSourcesNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="LockSourcesContractNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblBrakeThreshold"/>
                  <mah:NumericUpDown x:Name="LockBrakeThreshold" StringFormat="0"/>
                </StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LockLblFrontLeft"/>
                  <Button    Grid.Row="0" Grid.Column="1" x:Name="LockScriptTypeFl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="0" Grid.Column="2" x:Name="LockSourceFl"/>
                  <Button    Grid.Row="0" Grid.Column="3" x:Name="LockPickFl"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LockLblFrontRight"/>
                  <Button    Grid.Row="1" Grid.Column="1" x:Name="LockScriptTypeFr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="1" Grid.Column="2" x:Name="LockSourceFr"/>
                  <Button    Grid.Row="1" Grid.Column="3" x:Name="LockPickFr"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LockLblRearLeft"/>
                  <Button    Grid.Row="2" Grid.Column="1" x:Name="LockScriptTypeRl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="2" Grid.Column="2" x:Name="LockSourceRl"/>
                  <Button    Grid.Row="2" Grid.Column="3" x:Name="LockPickRl"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LockLblRearRight"/>
                  <Button    Grid.Row="3" Grid.Column="1" x:Name="LockScriptTypeRr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="3" Grid.Column="2" x:Name="LockSourceRr"/>
                  <Button    Grid.Row="3" Grid.Column="3" x:Name="LockPickRr"/>
                </Grid>
                <Button x:Name="LockResetSources" Padding="16,4" HorizontalAlignment="Left"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="LockCurveGroup">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblPreset"/>
                  <ComboBox x:Name="LockPresetCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="LockPresetLinear" Tag="Linear"/>
                    <ComboBoxItem x:Name="LockPresetCurve" Tag="Curve"/>
                    <ComboBoxItem x:Name="LockPresetCustom" Tag="Custom"/>
                  </ComboBox>
                </StackPanel>

                <TextBlock x:Name="LockAnchorNoteText" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LockColRawHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LockColOutputHeader" HorizontalAlignment="Center" FontWeight="Bold"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LockLblStart" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="LockStartRaw"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LockStartOutputStatic" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LockDescStart" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LockLblSlightly" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LockSlightlyRaw"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="2" x:Name="LockSlightlyOutput"/>
                  <TextBlock Grid.Row="3" Grid.Column="3" x:Name="LockLiveSlightly"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LockDescSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" x:Name="LockLblModerate" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="LockModerateRaw"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="2" x:Name="LockModerateOutput"/>
                  <TextBlock Grid.Row="5" Grid.Column="3" x:Name="LockLiveModerate"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LockDescModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" x:Name="LockLblCritical" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="1" x:Name="LockCriticalRaw"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="2" x:Name="LockCriticalOutput"/>
                  <TextBlock Grid.Row="7" Grid.Column="3" x:Name="LockLiveCritical"/>
                  <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LockDescCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="9" Grid.Column="0" x:Name="LockLblEnd" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="1" x:Name="LockEndRaw"/>
                  <TextBlock Grid.Row="9" Grid.Column="2" x:Name="LockEndOutputStatic" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LockDescEnd" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>
                </Grid>

                <Border BorderBrush="Gray" BorderThickness="1" Margin="4,8,4,4" HorizontalAlignment="Left">
                  <Canvas x:Name="LockCurveCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                    <Polyline x:Name="LockCurvePolyline" Stroke="DodgerBlue" StrokeThickness="2"/>
                    <Ellipse x:Name="LockStartMarker" Width="8" Height="8" Fill="Gray"/>
                    <Ellipse x:Name="LockSlightlyMarker" Width="8" Height="8" Fill="Orange"/>
                    <Ellipse x:Name="LockModerateMarker" Width="8" Height="8" Fill="DodgerBlue"/>
                    <Ellipse x:Name="LockCriticalMarker" Width="8" Height="8" Fill="Red"/>
                    <Ellipse x:Name="LockEndMarker" Width="8" Height="8" Fill="Gray"/>
                  </Canvas>
                </Border>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="LockPulseGroup">
              <StackPanel>
                <CheckBox x:Name="LockPulseEnabled"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LockLblGapMs"/><mah:NumericUpDown x:Name="LockPulseGapMs" Minimum="200" Maximum="5000" Interval="50"/>
                  <TextBlock x:Name="LockLblMinValue"/><mah:NumericUpDown x:Name="LockPulseMinValue"/>
                </StackPanel>
                <TextBlock x:Name="LockPulseFloorNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="WheelSlipTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox x:Name="SlipSourcesGroup">
              <StackPanel>
                <!-- Source mode toggle - see LockSourcesGroup's own remarks; identical layout/logic,
                     independently for this channel. -->
                <StackPanel x:Name="SlipSourceModePanel" Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblSourceMode"/>
                  <ComboBox x:Name="SlipSourceModeCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="SlipSourceModeManual" Tag="Manual"/>
                    <ComboBoxItem x:Name="SlipSourceModeShakeIt" Tag="ShakeIt"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="SlipShakeItSetupNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="SlipSourcesShakeItNote" TextWrapping="Wrap" FontStyle="Italic" Foreground="DarkOrange"/>
                <TextBlock x:Name="SlipManualNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <TextBlock x:Name="SlipSourcesNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock x:Name="SlipSourcesContractNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblBrakeThreshold"/>
                  <mah:NumericUpDown x:Name="SlipBrakeThreshold" StringFormat="0"/>
                  <TextBlock x:Name="SlipLblThrottleThreshold"/>
                  <mah:NumericUpDown x:Name="SlipThrottleThreshold" StringFormat="0"/>
                </StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SlipLblFrontLeft"/>
                  <Button    Grid.Row="0" Grid.Column="1" x:Name="SlipScriptTypeFl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="0" Grid.Column="2" x:Name="SlipSourceFl"/>
                  <Button    Grid.Row="0" Grid.Column="3" x:Name="SlipPickFl"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SlipLblFrontRight"/>
                  <Button    Grid.Row="1" Grid.Column="1" x:Name="SlipScriptTypeFr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="1" Grid.Column="2" x:Name="SlipSourceFr"/>
                  <Button    Grid.Row="1" Grid.Column="3" x:Name="SlipPickFr"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SlipLblRearLeft"/>
                  <Button    Grid.Row="2" Grid.Column="1" x:Name="SlipScriptTypeRl" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="2" Grid.Column="2" x:Name="SlipSourceRl"/>
                  <Button    Grid.Row="2" Grid.Column="3" x:Name="SlipPickRl"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SlipLblRearRight"/>
                  <Button    Grid.Row="3" Grid.Column="1" x:Name="SlipScriptTypeRr" Style="{StaticResource ScriptTypeToggleButtonStyle}"/>
                  <TextBox   Grid.Row="3" Grid.Column="2" x:Name="SlipSourceRr"/>
                  <Button    Grid.Row="3" Grid.Column="3" x:Name="SlipPickRr"/>
                </Grid>
                <Button x:Name="SlipResetSources" Padding="16,4" HorizontalAlignment="Left"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SlipCurveGroup">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblPreset"/>
                  <ComboBox x:Name="SlipPresetCombo" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="SlipPresetLinear" Tag="Linear"/>
                    <ComboBoxItem x:Name="SlipPresetCurve" Tag="Curve"/>
                    <ComboBoxItem x:Name="SlipPresetCustom" Tag="Custom"/>
                  </ComboBox>
                </StackPanel>

                <TextBlock x:Name="SlipAnchorNoteText" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SlipColRawHeader" HorizontalAlignment="Center" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SlipColOutputHeader" HorizontalAlignment="Center" FontWeight="Bold"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SlipLblStart" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="SlipStartRaw"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SlipStartOutputStatic" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SlipDescStart" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SlipLblSlightly" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="SlipSlightlyRaw"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="2" x:Name="SlipSlightlyOutput"/>
                  <TextBlock Grid.Row="3" Grid.Column="3" x:Name="SlipLiveSlightly"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SlipDescSlightly" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" x:Name="SlipLblModerate" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="SlipModerateRaw"/>
                  <mah:NumericUpDown Grid.Row="5" Grid.Column="2" x:Name="SlipModerateOutput"/>
                  <TextBlock Grid.Row="5" Grid.Column="3" x:Name="SlipLiveModerate"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SlipDescModerate" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" x:Name="SlipLblCritical" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="1" x:Name="SlipCriticalRaw"/>
                  <mah:NumericUpDown Grid.Row="7" Grid.Column="2" x:Name="SlipCriticalOutput"/>
                  <TextBlock Grid.Row="7" Grid.Column="3" x:Name="SlipLiveCritical"/>
                  <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SlipDescCritical" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>

                  <TextBlock Grid.Row="9" Grid.Column="0" x:Name="SlipLblEnd" FontWeight="Bold"/>
                  <mah:NumericUpDown Grid.Row="9" Grid.Column="1" x:Name="SlipEndRaw"/>
                  <TextBlock Grid.Row="9" Grid.Column="2" x:Name="SlipEndOutputStatic" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SlipDescEnd" TextWrapping="Wrap" FontStyle="Italic" Margin="4,0,4,8"/>
                </Grid>

                <Border BorderBrush="Gray" BorderThickness="1" Margin="4,8,4,4" HorizontalAlignment="Left">
                  <Canvas x:Name="SlipCurveCanvas" Width="420" Height="160" Background="White" ClipToBounds="True">
                    <Polyline x:Name="SlipCurvePolyline" Stroke="DodgerBlue" StrokeThickness="2"/>
                    <Ellipse x:Name="SlipStartMarker" Width="8" Height="8" Fill="Gray"/>
                    <Ellipse x:Name="SlipSlightlyMarker" Width="8" Height="8" Fill="Orange"/>
                    <Ellipse x:Name="SlipModerateMarker" Width="8" Height="8" Fill="DodgerBlue"/>
                    <Ellipse x:Name="SlipCriticalMarker" Width="8" Height="8" Fill="Red"/>
                    <Ellipse x:Name="SlipEndMarker" Width="8" Height="8" Fill="Gray"/>
                  </Canvas>
                </Border>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SlipPulseGroup">
              <StackPanel>
                <CheckBox x:Name="SlipPulseEnabled"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SlipLblGapMs"/><mah:NumericUpDown x:Name="SlipPulseGapMs" Minimum="200" Maximum="5000" Interval="50"/>
                  <TextBlock x:Name="SlipLblMinValue"/><mah:NumericUpDown x:Name="SlipPulseMinValue"/>
                </StackPanel>
                <TextBlock x:Name="SlipPulseFloorNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="GForceTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox x:Name="GForceMaximaGroup">
              <StackPanel>
                <TextBlock x:Name="GForceMaximaNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="GForceLblAccelMax"/>
                  <ComboBox x:Name="GForceAccelModeCombo">
                    <ComboBoxItem x:Name="GForceAccelModeFixed" Tag="Fixed"/>
                    <ComboBoxItem x:Name="GForceAccelModeAuto" Tag="Auto"/>
                  </ComboBox>
                  <mah:NumericUpDown x:Name="GForceFixedAccelMax" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
                  <TextBlock x:Name="GForceAccelLearnedText"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="GForceLblDecelMax"/>
                  <ComboBox x:Name="GForceDecelModeCombo">
                    <ComboBoxItem x:Name="GForceDecelModeFixed" Tag="Fixed"/>
                    <ComboBoxItem x:Name="GForceDecelModeAuto" Tag="Auto"/>
                  </ComboBox>
                  <mah:NumericUpDown x:Name="GForceFixedDecelMax" Minimum="0.1" Maximum="10" Interval="0.1" StringFormat="0.00"/>
                  <TextBlock x:Name="GForceDecelLearnedText"/>
                </StackPanel>

                <TextBlock x:Name="GForceRecommendedHzText" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceSustainGroup">
              <StackPanel>
                <TextBlock x:Name="GForceSustainNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblBrakeBottomRear"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceBrakeBottomRearSustain"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblBrakeBackLow"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceBrakeBackLowSustain"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblAccelBottomRear"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceAccelBottomRearSustain"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" x:Name="GForceLblAccelBackLow"/>
                  <mah:NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="GForceAccelBackLowSustain"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceMotionGroup">
              <StackPanel>
                <TextBlock x:Name="GForceMotionNote" TextWrapping="Wrap" FontStyle="Italic"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblSustainTau"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceSustainTau" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblTransientTau"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceTransientTau" Minimum="0.01" Maximum="3" Interval="0.01" StringFormat="0.00"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblTransientGain"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceTransientGain" Minimum="0" Maximum="5" Interval="0.1" StringFormat="0.0"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceLateralGroup">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="GForceLblLateralDirection"/>
                  <ComboBox x:Name="GForceLateralDirectionCombo">
                    <ComboBoxItem x:Name="GForceLateralNormal" Tag="Normal"/>
                    <ComboBoxItem x:Name="GForceLateralReversed" Tag="Reversed"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="GForceLateralDirectionNote" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GForceShakeGroup">
              <StackPanel>
                <!-- A feature SWITCH, not a minor checkbox option (owner's explicit distinction) -
                     a prominent MahApps ToggleSwitch, sitting above the settings it governs, with
                     both states spelled out via OnLabel/OffLabel (never inferred from a highlight
                     alone) and a bold header naming the feature. -->
                <TextBlock x:Name="GForceShakeHeader" FontWeight="Bold" FontSize="14" Margin="4,4,4,0"/>
                <mah:ToggleSwitch x:Name="GForceShakeEnabled" HorizontalAlignment="Left" Margin="4,2,4,8"/>
                <TextBlock x:Name="GForceShakeNote" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="GForceLblShakeFrequency"/>
                  <mah:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GForceShakeFrequency" Minimum="5" Maximum="20" Interval="1" StringFormat="0.#"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="GForceLblShakeLockScale"/>
                  <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GForceShakeLockScale" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GForceLblShakeSlipScale"/>
                  <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="GForceShakeSlipScale" Minimum="0" Maximum="10" Interval="0.1" StringFormat="0.0"/>
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================================ -->
      <TabItem x:Name="GeneralTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox x:Name="GeneralGroup">
              <StackPanel>
                <CheckBox x:Name="EnableDiagnosticsCheckBox"/>
                <TextBlock x:Name="EnableDiagnosticsNote" TextWrapping="Wrap" FontStyle="Italic" Margin="20,0,4,4"/>
                <TextBlock x:Name="EnableDiagnosticsRestartNote" TextWrapping="Wrap" FontWeight="Bold" Margin="20,0,4,8"/>

                <CheckBox x:Name="ExportCsvCheckBox"/>
                <TextBlock x:Name="ExportCsvNote" TextWrapping="Wrap" FontStyle="Italic" Margin="20,0,4,4"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</UserControl>
